<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- User Message Bubble (Right Aligned) -->
    <LinearLayout
        android:id="@+id/layoutUserContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:background="@drawable/bg_jarvis_chat_user"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="Hi"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp">

            <ImageView
                android:id="@+id/btnUserEdit"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_edit"
                app:tint="?attr/themeTextMuted"
                android:layout_marginEnd="10dp" />

            <ImageView
                android:id="@+id/btnUserCopy"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Assistant Message Bubble (Left Aligned) -->
    <LinearLayout
        android:id="@+id/layoutAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <com.jarvis.assistant.ui.chat.DustRevealTextView
            android:id="@+id/tvAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:background="@drawable/bg_jarvis_chat_assistant"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="Hey! I'm doing great, aap. How are you feeling today? 😊"
            android:textColor="?attr/themeTextPrimary"
            android:fontFamily="sans-serif"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:id="@+id/layoutFileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_jarvis_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_code_chip"
                app:tint="?attr/themeAccent"
                android:contentDescription="Dosya" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingEnd="6dp">
                <TextView
                    android:id="@+id/tvFileArtifactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="dosya.txt" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dosyayı kopyala veya İndir klasörüne kaydet"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnFileArtifactCopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="Kopyala"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnFileArtifactDownload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="İndir"
                android:textColor="?attr/themeAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp">

            <ImageView
                android:id="@+id/btnAssistantCopy"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_copy"
                app:tint="?attr/themeTextMuted"
                android:layout_marginEnd="12dp" />

            <ImageView
                android:id="@+id/btnAssistantPlay"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_tts_play"
                app:tint="?attr/themeTextMuted" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
