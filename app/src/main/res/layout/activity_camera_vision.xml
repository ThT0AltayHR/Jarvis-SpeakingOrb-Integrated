<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cameraVisionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B">

    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.jarvis.assistant.ui.home.CameraParticleOverlayView
        android:id="@+id/cameraParticleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:background="#B5000000">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Geri"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANLI GÖRÜŞ"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCameraStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Kamera hazırlanıyor…"
                android:textColor="#D7DEE8"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSwitchCamera"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:text="ÖN KAMERA"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263747" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCameraHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#C9000000"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:gravity="center"
        android:text="Görüntü, aktif Jarvis canlı oturumuna gönderilir. Kapatmak için geri dön."
        android:textColor="#EDF2F8"
        android:textSize="13sp" />
</FrameLayout>
