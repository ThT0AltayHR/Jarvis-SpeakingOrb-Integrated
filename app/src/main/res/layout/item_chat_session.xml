<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvSessionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Yeni sohbet" />

    <TextView
        android:id="@+id/tvSessionPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Sohbet önizlemesi" />

    <TextView
        android:id="@+id/tvSessionTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="?attr/themeAccent"
        android:textSize="11sp"
        android:text="21 Eki · 17:00" />
</LinearLayout>
